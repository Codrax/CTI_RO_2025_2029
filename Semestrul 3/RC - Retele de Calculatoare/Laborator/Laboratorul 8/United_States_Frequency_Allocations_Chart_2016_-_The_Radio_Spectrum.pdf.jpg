        <script>
        (function() {
            var NIGHT_START_HOUR = 20;
            var NIGHT_END_HOUR = 7;

            // Must match theme_cv26\output\core_renderer::FONTSIZE_CLASSES /
            // FONTSIZE_PERCENTAGES on the server.
            var FONTSIZE_MIN = -1;
            var FONTSIZE_MAX = 3;
            var FONTSIZE_CLASSES = {
                '-1': 'theme-cv26-fontsize-sm',
                '0': null,
                '1': 'theme-cv26-fontsize-lg',
                '2': 'theme-cv26-fontsize-xl',
                '3': 'theme-cv26-fontsize-xxl'
            };
            var FONTSIZE_PERCENTAGES = {'-1': 87, '0': 100, '1': 112, '2': 125, '3': 137};

            // A cookie is set synchronously and read server-side as a fallback,
            // so choices survive a reload even for guests or if the
            // core_user/repository AJAX save below fails. Logged-in users also
            // get a real user preference saved, which takes priority once it
            // exists (see theme_cv26 core_renderer::body_attributes()).
            var setCookie = function(name, value) {
                var expires = new Date(Date.now() + 365 * 24 * 60 * 60 * 1000).toUTCString();
                document.cookie = name + '=' + value + '; expires=' + expires + '; path=/; SameSite=Lax';
            };
            var saveUserPreference = function(name, value) {
                require(['core_user/repository'], function(UserRepository) {
                    UserRepository.setUserPreference(name, value).catch(function() {
                        // Ignore failures (e.g. guest sessions); the cookie above already covers this case.
                    });
                });
            };

            var computeAutoIsDark = function() {
                var hour = new Date().getHours();
                // Must match theme_cv26\output\core_renderer::hour_is_night()
                // on the server — handles both an overnight window (e.g. the
                // 20-7 default) and a same-day one (e.g. 1-5) the same way.
                if (NIGHT_START_HOUR === NIGHT_END_HOUR) {
                    return false;
                }
                if (NIGHT_START_HOUR < NIGHT_END_HOUR) {
                    return (hour >= NIGHT_START_HOUR && hour < NIGHT_END_HOUR);
                }
                return (hour >= NIGHT_START_HOUR || hour < NIGHT_END_HOUR);
            };

            var autoIntervalId = null;
            var ensureAutoRecheck = function() {
                if (autoIntervalId !== null) {
                    return;
                }
                // Re-evaluate periodically so a tab left open overnight still flips
                // automatically at the day/night boundary, without a page reload.
                autoIntervalId = setInterval(function() {
                    if (document.body.getAttribute('data-nightmode') === 'auto') {
                        document.body.classList.toggle('dark-mode', computeAutoIsDark());
                    }
                }, 15 * 60 * 1000);
            };

            // TinyMCE (editor_tiny) renders the actual typing area inside its
            // own <iframe>, a completely separate document our theme's CSS
            // never reaches — so dark mode there needs its own small
            // stylesheet injected directly into each editor's iframe
            // document, kept in sync with the 'dark-mode' body class.
            var TINY_IFRAME_SELECTOR = 'iframe.tox-edit-area__iframe';
            var TINY_STYLE_ID = 'cv26-tinymce-dark-mode';
            // Background/text colours match the theme_cv26/darkbg*+darktext
            // settings (same values post.scss's $cv26-dark-* Sass variables
            // resolve to — see core_renderer::get_dark_colors()); the
            // remaining accent/border colours here aren't part of that
            // admin-configurable palette, same as their post.scss counterparts.
            var TINY_DARK_CSS = 'body{background-color:#1e1e1e!important;color:#e0e0e0!important}'
                + 'a{color:#8ab4f8!important}'
                + 'table td,table th{border-color:#444!important}'
                + 'hr{border-color:#444!important}'
                + 'blockquote{border-color:#444!important;color:#c0c0c0!important}'
                + 'pre,code{background-color:#2a2a2a!important;color:#e0e0e0!important}';

            var applyTinyIframeDarkMode = function(iframe, isDark) {
                var doc = iframe.contentDocument;
                if (!doc || !doc.head) {
                    // Still the initial 'about:blank' document, or cross-origin
                    // (shouldn't happen for a same-site editor) — the 'load'
                    // listener registered by watchTinyIframe() will retry once
                    // TinyMCE has actually written its real document into it.
                    return;
                }
                var style = doc.getElementById(TINY_STYLE_ID);
                if (isDark) {
                    if (!style) {
                        style = doc.createElement('style');
                        style.id = TINY_STYLE_ID;
                        doc.head.appendChild(style);
                    }
                    style.textContent = TINY_DARK_CSS;
                } else if (style) {
                    style.remove();
                }
            };

            var isDarkModeActive = function() {
                return document.body.classList.contains('dark-mode');
            };

            var applyTinyMceDarkMode = function() {
                var isDark = isDarkModeActive();
                document.querySelectorAll(TINY_IFRAME_SELECTOR).forEach(function(iframe) {
                    applyTinyIframeDarkMode(iframe, isDark);
                });
            };

            // TinyMCE (re)writes its iframe's document from scratch on init,
            // firing a real 'load' event once that's done — existing editors
            // at DOMContentLoaded may already be past that point (handled by
            // the immediate call in applyTinyMceDarkMode() below), but
            // editors created later (AJAX-loaded forms, modals, 'Add
            // discussion topic', ...) need this to catch their iframe's load.
            var watchTinyIframe = function(iframe) {
                if (iframe.dataset.cv26DarkModeWatched) {
                    return;
                }
                iframe.dataset.cv26DarkModeWatched = '1';
                iframe.addEventListener('load', function() {
                    applyTinyIframeDarkMode(iframe, isDarkModeActive());
                });
            };

            var tinyObserver = new MutationObserver(function(mutations) {
                mutations.forEach(function(mutation) {
                    mutation.addedNodes.forEach(function(node) {
                        if (node.nodeType !== 1) {
                            return;
                        }
                        if (node.matches && node.matches(TINY_IFRAME_SELECTOR)) {
                            watchTinyIframe(node);
                        }
                        // This observer watches the whole document (TinyMCE
                        // editors can appear anywhere — forum posts, feedback
                        // forms, ...), so it sees every element inserted on
                        // the page, not just editor-related ones; skip the
                        // subtree walk below for childless nodes, which can't
                        // possibly contain a nested iframe.
                        if (node.children && node.children.length && node.querySelectorAll) {
                            node.querySelectorAll(TINY_IFRAME_SELECTOR).forEach(watchTinyIframe);
                        }
                    });
                });
            });

            var applyNightMode = function(mode) {
                var isDark = (mode === 'night') || (mode === 'auto' && computeAutoIsDark());
                document.body.classList.toggle('dark-mode', isDark);
                document.body.setAttribute('data-nightmode', mode);
                if (mode === 'auto') {
                    ensureAutoRecheck();
                }
                applyTinyMceDarkMode();
            };

            var updateActiveNightModeItem = function(mode) {
                // The 3 options are a segmented btn-group switch (mutually exclusive
                // toggle buttons), so aria-pressed is the correct state attribute here,
                // not aria-current (which is for links to other views/pages).
                document.querySelectorAll('[data-nightmode-option]').forEach(function(item) {
                    var isactive = item.getAttribute('data-nightmode-option') === mode;
                    item.classList.toggle('active', isactive);
                    item.setAttribute('aria-pressed', isactive ? 'true' : 'false');
                });
            };

            var getFontSizeStep = function() {
                for (var step = FONTSIZE_MIN; step <= FONTSIZE_MAX; step++) {
                    var cls = FONTSIZE_CLASSES[step];
                    if (cls && document.documentElement.classList.contains(cls)) {
                        return step;
                    }
                }
                return 0;
            };

            var updateFontSizeControls = function(step) {
                document.querySelectorAll('[data-region="cv26-fontsize-value"]').forEach(function(el) {
                    el.textContent = FONTSIZE_PERCENTAGES[step] + '%';
                });
                document.querySelectorAll('[data-fontsize-action="decrease"]').forEach(function(el) {
                    el.disabled = (step <= FONTSIZE_MIN);
                });
                document.querySelectorAll('[data-fontsize-action="increase"]').forEach(function(el) {
                    el.disabled = (step >= FONTSIZE_MAX);
                });
            };

            var applyFontSize = function(step) {
                step = Math.max(FONTSIZE_MIN, Math.min(FONTSIZE_MAX, step));
                Object.keys(FONTSIZE_CLASSES).forEach(function(key) {
                    if (FONTSIZE_CLASSES[key]) {
                        document.documentElement.classList.remove(FONTSIZE_CLASSES[key]);
                    }
                });
                if (FONTSIZE_CLASSES[step]) {
                    document.documentElement.classList.add(FONTSIZE_CLASSES[step]);
                }
                updateFontSizeControls(step);
                setCookie('theme_cv26_fontsize', String(step));
                saveUserPreference('theme_cv26_fontsize', String(step));
            };

            // The user menu (core/user_menu, built server-side by
            // core\navigation\output\primary::get_user_menu()) always adds its
            // own "Language" submenu for logged-in users, regardless of theme —
            // there's no PHP-level hook to identify it directly (its trigger is
            // just another item in the same array as everything else). Now that
            // theme_cv26\output\core_renderer::render_langmenu() gives every
            // user (not just guests) a language switcher of its own next to the
            // style menu, this one is only needed on mobile, where that navbar
            // switcher is hidden for lack of room (see theme_cv26/langmenu) — so
            // tag its trigger link (a ".carousel-navigation-link", identified by
            // which carousel panel it points at) with a class post.scss uses to
            // hide it at md+ only, rather than removing it outright.
            var tagUserMenuLanguageSubmenuTrigger = function() {
                var LANGUAGE_SUBMENU_LABEL = "Selector limb\u0103";
                document.querySelectorAll('.usermenu .carousel-navigation-link[data-carousel-target-id]').forEach(function(trigger) {
                    var panel = document.getElementById(trigger.getAttribute('data-carousel-target-id'));
                    if (panel && panel.getAttribute('aria-label') === LANGUAGE_SUBMENU_LABEL) {
                        trigger.classList.add('cv26-usermenu-langsubmenu-trigger');
                    }
                });
            };

            document.addEventListener('DOMContentLoaded', function() {
                tagUserMenuLanguageSubmenuTrigger();

                // Correct the server-rendered guess (based on the user's profile/site
                // timezone) with the browser's actual local time, and start the
                // periodic recheck if the saved mode is 'auto'.
                var currentMode = document.body.getAttribute('data-nightmode') || 'light';
                if (currentMode === 'auto') {
                    applyNightMode('auto');
                }

                // Keep the menu's displayed percentage/disabled state in sync with
                // whatever step the server actually rendered on <html>.
                updateFontSizeControls(getFontSizeStep());

                document.querySelectorAll(TINY_IFRAME_SELECTOR).forEach(watchTinyIframe);
                applyTinyMceDarkMode();
                tinyObserver.observe(document.body, {childList: true, subtree: true});

                document.body.addEventListener('click', function(e) {
                    var nightOption = e.target.closest('[data-nightmode-option]');
                    if (nightOption) {
                        e.preventDefault();
                        var mode = nightOption.getAttribute('data-nightmode-option');
                        applyNightMode(mode);
                        updateActiveNightModeItem(mode);
                        setCookie('theme_cv26_nightmode', mode);
                        saveUserPreference('theme_cv26_nightmode', mode);
                    }

                    var widthToggle = e.target.closest('[data-action="toggle-width"]');
                    if (widthToggle) {
                        e.preventDefault();
                        var isFluid = document.body.classList.toggle('theme-cv26-fluid');
                        setCookie('theme_cv26_fluidwidth', isFluid ? '1' : '0');
                        saveUserPreference('theme_cv26_fluidwidth', isFluid ? '1' : '0');
                    }

                    var fontSizeAction = e.target.closest('[data-fontsize-action]');
                    if (fontSizeAction && !fontSizeAction.disabled) {
                        e.preventDefault();
                        var action = fontSizeAction.getAttribute('data-fontsize-action');
                        var current = getFontSizeStep();
                        var next = current;
                        if (action === 'decrease') {
                            next = current - 1;
                        } else if (action === 'increase') {
                            next = current + 1;
                        } else if (action === 'reset') {
                            next = 0;
                        }
                        applyFontSize(next);
                    }

                    var highContrastToggle = e.target.closest('[data-action="toggle-highcontrast"]');
                    if (highContrastToggle) {
                        e.preventDefault();
                        var isHighContrast = document.body.classList.toggle('theme-cv26-highcontrast');
                        setCookie('theme_cv26_highcontrast', isHighContrast ? '1' : '0');
                        saveUserPreference('theme_cv26_highcontrast', isHighContrast ? '1' : '0');
                    }

                });

                // The course index / blocks drawer toggles stay visible and
                // in place (rather than disappearing, like Boost's default)
                // once their drawer is open — see post.scss. Bootstrap's
                // tooltip on them needs hiding once that happens; Boost's own
                // theme_boost/drawers.js disable/enable-tooltip helpers
                // (disableButtonTooltip()/enableButtonTooltip()) try to do
                // this but read/write "button.dataset.toggle", when the real
                // attribute is "data-bs-toggle" (=> "button.dataset.bsToggle"
                // in the DOM dataset API) — that mismatch means they strip the
                // real "data-bs-toggle" attribute without ever calling the
                // real Tooltip.disable() (a second dead code path, guarded by
                // an equally-wrong "data-original-title" check), so the
                // tooltip is never actually disabled, just hidden for a
                // moment. Both openDrawer() and closeDrawer() then
                // programmatically re-focus a toggle button ~300ms later, as
                // keyboard-accessibility behaviour (returning focus to the
                // control that opened/closes the drawer) — and since the
                // tooltip's default trigger is "hover focus", that focus()
                // call alone pops it back up with no real mouse hover
                // involved.
                //
                // Listening for clicks on the toggle isn't enough to catch
                // every case: theme_boost/drawers.js also closes the *other*
                // drawer for you on small screens when one is opened
                // ("Drawers.closeOtherDrawers"), running that same broken
                // close/re-focus sequence on a button that was never clicked
                // or hovered at all. Listening for Boost's own "drawer
                // shown"/"hidden" events instead — which fire for every
                // drawer state change regardless of what caused it — and
                // sweeping both toggle buttons each time covers that case
                // too. Work around it with the real API instead of Boost's
                // broken wrapper: hide each tooltip, disable it (blocking
                // both the hover AND focus triggers, unlike Boost's no-op),
                // then re-enable after a delay comfortably past that ~300ms
                // re-focus, so normal hovering keeps working afterwards.
                var settleDrawerToggleTooltips = function() {
                    require(['theme_boost/bootstrap/tooltip'], function(Tooltip) {
                        document.querySelectorAll('.drawer-toggler .btn').forEach(function(btn) {
                            var instance = Tooltip.getOrCreateInstance(btn);
                            instance.hide();
                            instance.disable();
                            setTimeout(function() {
                                instance.enable();
                            }, 500);
                        });
                    });
                };
                document.addEventListener('theme_boost/drawers:shown', settleDrawerToggleTooltips);
                document.addEventListener('theme_boost/drawers:hidden', settleDrawerToggleTooltips);
            });
        })();
        </script><div class="tool_dataprivacy"><a href="https://cv.upt.ro/admin/tool/dataprivacy/summary.php">Rezumatul păstrării datelor</a></div><div class="policiesfooter"><a href="https://cv.upt.ro/admin/tool/policy/viewall.php?returnurl=https%3A%2F%2Fcv.upt.ro%2Flogin%2Findex.php">Politici utilizare site</a></div>
